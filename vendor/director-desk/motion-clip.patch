+
+function supportedPose(actor: DirectorObject, assets: DirectorAssetRef[]) {
+  const readiness = assets.find((asset) => asset.id === actor.assetRefId)?.characterImportReadiness;
+  return Boolean(actor.characterRig) && (!readiness || readiness === "ready");
+}
+
+function holderChoice(holder: MotionClipHolder | null | undefined) {
+  return holder ? `actor:${holder.actorId}:${holder.hand}` : "floor";
+}
+
+function holderForChoice(value: string, actors: DirectorObject[], previous: MotionClipHolder | null | undefined) {
+  if (holderChoice(previous) === value) return previous ?? null;
+  for (const actor of actors) {
+    if (value === `actor:${actor.id}:left`) return { actorId: actor.id, hand: "left" } as const;
+    if (value === `actor:${actor.id}:right`) return { actorId: actor.id, hand: "right" } as const;
+  }
+  return null;
+}
+
+function TransformFields({ transform, labels, onChange }: {
+  transform: DirectorTransform;
+  labels: ClipLabels;
+  onChange: (transform: DirectorTransform) => void;
+}) {
+  return <>{(["position", "rotation"] as const).map((field) => (
+    <fieldset className="motion-clip-coordinate" key={field}>
+      <legend>{labels[field]}</legend>
+      <div>{AXES.map((axis, index) => (
+        <label key={axis}><span>{axis}</span>
+          <ClipNumberField aria-label={`${labels[field]} ${axis}`} step={field === "position" ? .05 : 1}
+            data-testid={`motion-clip-actor-${field}-${axis.toLowerCase()}`}
+            value={Number((transform[field][index] * (field === "rotation" ? DEGREES_PER_RADIAN : 1)).toFixed(3))}
+            onCommit={(value) => {
+              const values = [...transform[field]] as DirectorTransform[typeof field];
+              values[index] = field === "rotation" ? value / DEGREES_PER_RADIAN : value;
+              onChange({ ...transform, [field]: values });
+            }} />
+        </label>
+      ))}</div>
+    </fieldset>
+  ))}</>;
+}
+
+function PoseFields({ controls, angleLimit, english, labels, onChange }: {
+  controls: Record<string, number>;
+  angleLimit: number;
+  english: boolean;
+  labels: ClipLabels;
+  onChange: (controls: Record<string, number>) => void;
+}) {
+  const [joint, setJoint] = useState("rightShoulder.pitch");
+  const height = joint === "body.offsetY";
+  const max = height ? 2 : angleLimit;
+  const min = -max;
+  const step = height ? .01 : 1;
+  const sliderValue = Math.max(min, Math.min(max, controls[joint] ?? 0));
+  function updateJoint(value: number) {
+    onChange({ ...controls, [joint]: Math.max(min, Math.min(max, value)) });
+  }
+  return <>
+    <label>{labels.posePreset}
+      <select value="" data-testid="motion-clip-pose-preset" onChange={(event) => {
+        const preset = MANNEQUIN_POSE_PRESETS.find((item) => item.id === event.currentTarget.value);
+        if (preset) onChange({ ...preset.controls });
+      }}>
+        <option value="">{labels.choosePreset}</option>
+        {MANNEQUIN_POSE_PRESETS.map((preset) => (
+          <option key={preset.id} value={preset.id}>{english ? englishPoseNames[preset.id] : preset.label}</option>
+        ))}
+      </select>
+    </label>
+    <details className="motion-clip-disclosure" open>
+      <summary><ChevronRight aria-hidden="true" size={14} />{labels.joint}</summary>
+      <select aria-label={labels.joint} data-testid="motion-clip-joint" value={joint}
+        onChange={(event) => setJoint(event.currentTarget.value)}>
+        {clipJointGroups.map((group) => (
+          <optgroup key={group.names[1]} label={group.names[+english]}>
+            {group.controls.map((control) => (
+              <option key={control.id} value={control.id} data-testid={`motion-clip-joint-${control.id}`}>
+                {group.names[+english]} · {control.names[+english]}
+              </option>
+            ))}
+          </optgroup>
+        ))}
+      </select>
+      <div className="motion-clip-joint-value">
+        <input type="range" min={min} max={max} step={step} value={sliderValue}
+          aria-label={height ? labels.height : labels.degrees} data-testid="motion-clip-joint-slider"
+          onChange={(event) => updateJoint(event.currentTarget.valueAsNumber)} />
+        <ClipNumberField key={joint} aria-label={height ? labels.height : labels.degrees} data-testid="motion-clip-joint-angle"
+          value={Number(sliderValue.toFixed(3))} onCommit={updateJoint} min={min} max={max} step={step} />
+      </div>
+    </details>
+  </>;
+}
+
+function KeyframeActions({ frame, duration, labels, onMove, onDuplicate, onDelete }: {
+  frame: MotionClipActorKeyframe;
+  duration: number;
+  labels: ClipLabels;
+  onMove: (time: number) => void;
+  onDuplicate: (time: number) => void;
+  onDelete: () => void;
+}) {
+  const [target, setTarget] = useState(() => frame.time + .25 <= duration ? frame.time + .25 : Math.max(0, frame.time - .25));
+  return <div className="motion-clip-key-edit">
+    <label>{labels.keyTime}
+      <ClipNumberField data-testid="motion-clip-key-time" value={target} step={.001} min={0} max={duration}
+        onCommit={(value) => setTarget(normalizeMotionClipTime(value, duration))} />
+    </label>
+    <div className="motion-clip-actions">
+      <button type="button" data-testid="motion-clip-move" onClick={() => onMove(target)}>{labels.move}</button>
+      <button type="button" data-testid="motion-clip-duplicate" onClick={() => onDuplicate(target)}>{labels.copy}</button>
+      <button type="button" data-testid="motion-clip-delete" onClick={onDelete}>{labels.delete}</button>
+    </div>
+  </div>;
+}
+
+export function MotionClipWorkspace({ english }: { english: boolean }) {
+  const project = useDirectorStore((state) => state.project);
+  const selectedObjectId = useDirectorStore((state) => state.selectedObjectId);
+  const canUndo = useDirectorStore((state) => state.undoStack.length > 0);
+  const session = useMotionClipSession();
+  const labels = motionClipLabels(english);
+  const clip = project.motionClip ?? EMPTY_CLIP;
+  const [tab, setTab] = useState<EditTab>("actor");
+  const [propId, setPropId] = useState<string | null>(null);
+  const [newInterpolation, setNewInterpolation] = useState<"linear" | "hold">("linear");
+  const [newHolderChoice, setNewHolderChoice] = useState<string | null>(null);
+  const [notice, setNotice] = useState("");
+  const fileRef = useRef<HTMLInputElement>(null);
+  const openFileRequest = useRef(0);
+  const time = normalizeMotionClipTime(session.time, clip.duration);
+  const actors = project.objects.filter((item) => item.kind === "character" && item.visible);
+  const props = project.objects.filter((item) => item.kind === "prop" && item.visible);
+  const actor = actors.find((item) => item.id === session.selectedActorId) ?? actors[0];
+  const prop = props.find((item) => item.id === propId) ?? props[0];
+  const pose = actor && (session.draftActor?.actorId === actor.id ? session.draftActor
+    : sampleMotionActor(clip, actor.id, time) ?? { transform: actor.transform, controls: actor.characterRig?.controls ?? {} });
+  const actorTrack = clip.actorTracks.find((track) => track.actorId === actor?.id);
+  const propTrack = clip.propTracks.find((track) => track.propId === prop?.id);
+  const currentActorKey = actorTrack?.keyframes.find((frame) => frame.time === time);
+  const currentPropKey = propTrack?.keyframes.find((frame) => frame.time === time);
+  const holder = prop && sampleMotionProp(clip, prop.id, time);
+  const tracks = project.objects.flatMap((item) => {
+    const track = item.kind === "character" ? clip.actorTracks.find((candidate) => candidate.actorId === item.id)
+      : item.kind === "prop" ? clip.propTracks.find((candidate) => candidate.propId === item.id) : undefined;
+    return item.visible && (track || item.id === actor?.id || (tab === "prop" && item.id === prop?.id))
+      ? [{ item, frames: track?.keyframes ?? [] }] : [];
+  });
+
+  useEffect(() => {
+    const selected = project.objects.find((item) => item.id === selectedObjectId && item.visible);
+    if (selected?.kind === "character") {
+      const { selectedActorId, selectActor } = useMotionClipSession.getState();
+      if (selected.id !== selectedActorId) selectActor(selected.id);
+      setTab("actor");
+    } else if (selected?.kind === "prop") {
+      setPropId(selected.id);
+      setTab("prop");
+    }
+  }, [selectedObjectId]);
+
+  useEffect(() => {
+    if (!session.playing) return;
+    let request: number;
+    let previous = performance.now();
+    function next(now: number) {
+      const state = useMotionClipSession.getState();
+      state.advance(Math.max(0, now - previous) / 1000, clip.duration);
+      previous = now;
+      request = requestAnimationFrame(next);
+    }
+    request = requestAnimationFrame(next);
+    return () => cancelAnimationFrame(request);
+  }, [session.playing, clip.duration]);
+
+  useEffect(() => () => { openFileRequest.current += 1; }, []);
+
+  useEffect(() => {
+    const state = useMotionClipSession.getState();
+    if (state.time > clip.duration) state.seek(clip.duration);
+  }, [clip.duration]);
+
+  const seek = (value: number) => {
+    setNotice("");
+    setNewHolderChoice(null);
+    session.seek(normalizeMotionClipTime(value, clip.duration));
+  };
+
+  function changeDuration(value: number) {
+    const shorter = resizeMotionClip(clip, value);
+    if ([...clip.actorTracks, ...clip.propTracks].some((track) => track.keyframes.some((frame) => frame.time > shorter.duration))) {
+      setNotice(labels.unsafeDuration);
+      return;
+    }
+    useDirectorStore.getState().setMotionClip(shorter);
+    if (time > shorter.duration) session.seek(shorter.duration);
+    setNotice("");
+  }
+
+  function selectTrack(item: DirectorObject) {
+    setNewHolderChoice(null);
+    setNotice("");
+    if (item.kind === "character") {
+      setTab("actor");
+      session.selectActor(item.id);
+    } else {
+      setTab("prop");
+      setPropId(item.id);
+      session.seek(time);
+    }
+    useDirectorStore.getState().selectObject(item.id);
+  }
+
+  function setPose(patch: Partial<Omit<MotionClipActorDraft, "actorId">>) {
+    if (actor && pose) session.setDraftActor({ actorId: actor.id, transform: pose.transform, controls: pose.controls, ...patch });
+  }
+
+  function saveActorKey() {
+    if (!actor || !pose) return;
+    useDirectorStore.getState().setMotionClip(upsertMotionActorFrame(clip, actor.id, {
+      id: currentActorKey?.id ?? crypto.randomUUID(), time, transform: pose.transform, controls: pose.controls,
+      interpolation: currentActorKey?.interpolation ?? newInterpolation,
+    }));
+    session.seek(time);
+    setNotice("");
+  }
+
+  function changeInterpolation(interpolation: "linear" | "hold") {
+    setNewInterpolation(interpolation);
+    if (actor && currentActorKey) useDirectorStore.getState().setMotionClip(
+      upsertMotionActorFrame(clip, actor.id, { ...currentActorKey, interpolation })
+    );
+  }
+
+  function relocateActorKey(target: number, copy: boolean) {
+    if (!actor || !currentActorKey) return;
+    target = normalizeMotionClipTime(target, clip.duration);
+    if (actorTrack?.keyframes.some((frame) => frame.time === target)) {
+      setNotice(labels.keyConflict);
+      return;
+    }
+    useDirectorStore.getState().setMotionClip(upsertMotionActorFrame(clip, actor.id, {
+      ...currentActorKey, id: copy ? crypto.randomUUID() : currentActorKey.id, time: target,
+    }));
+    seek(target);
+  }
+
+  function savePropKey() {
+    if (!prop) return;
+    const choice = newHolderChoice ?? holderChoice(holder);
+    useDirectorStore.getState().setMotionClip(upsertMotionPropFrame(clip, prop.id, {
+      id: currentPropKey?.id ?? crypto.randomUUID(), time, holder: holderForChoice(choice, actors, holder),
+    }));
+    setNewHolderChoice(null);
+    setNotice("");
+  }
+
+  function saveProject() {
+    const link = document.createElement("a");
+    const url = URL.createObjectURL(new Blob([serializeProject(project)], { type: "application/json" }));
+    link.href = url;
+    link.download = "director-action-clip.json";
+    document.body.append(link);
+    link.click();
+    link.remove();
+    window.setTimeout(() => URL.revokeObjectURL(url), 5_000);
+    setNotice(labels.saved);
+  }
+
+  async function openProject(event: ChangeEvent<HTMLInputElement>) {
+    const file = event.currentTarget.files?.[0];
+    event.currentTarget.value = "";
+    if (!file) return;
+    const request = ++openFileRequest.current;
+    try {
+      if (file.size > MAX_PROJECT_BYTES) throw new RangeError();
+      const loaded = parseProject(await file.text());
+      if (request !== openFileRequest.current) return;
+      useDirectorStore.getState().replaceProject(loaded);
+      const first = loaded.objects.find((item) => item.kind === "character" && item.visible);
+      useMotionClipSession.getState().open(first?.id ?? null);
+      setTab("actor");
+      setPropId(null);
+      setNewHolderChoice(null);
+      setNotice(labels.opened);
+    } catch {
+      if (request === openFileRequest.current) setNotice(labels.openFailed);
+    }
+  }
+
+  return <>
+    <aside className="right-sidebar director-sidebar motion-clip-inspector" aria-label={labels.title}>
+      <div className="motion-clip-inspector-header">
+        <h2>{labels.title}</h2>
+        <button type="button" data-testid="motion-clip-undo" disabled={!canUndo} onClick={() => {
+          useDirectorStore.getState().undo();
+          seek(time);
+        }}>{labels.undo}</button>
+      </div>
+      <div className="motion-clip-tabs" role="group" aria-label={labels.title}>
+        <button type="button" aria-pressed={tab === "actor"} data-testid="motion-clip-actor-tab"
+          onClick={() => setTab("actor")}>{labels.actorTab}</button>
+        <button type="button" aria-pressed={tab === "prop"} data-testid="motion-clip-prop-tab"
+          onClick={() => setTab("prop")}>{labels.propTab}</button>
+      </div>
+      <div className="motion-clip-inspector-scroll">
+      {notice && <p className="motion-clip-notice" role="status" data-testid="motion-clip-status">{notice}</p>}
+      {tab === "actor" ? actor && pose ? <div className="motion-clip-editor">
+        <label>{labels.actor}<select data-testid="motion-clip-actor" value={actor.id} onChange={(event) => {
+          const selected = actors.find((item) => item.id === event.currentTarget.value);
+          if (selected) selectTrack(selected);
+        }}>{actors.map((item) => <option key={item.id} value={item.id}>{trackName(item, english)}</option>)}</select></label>
+        <TransformFields transform={pose.transform} labels={labels} onChange={(transform) => setPose({ transform })} />
+        {supportedPose(actor, project.assets)
+          ? <PoseFields key={actor.id} controls={pose.controls} labels={labels} english={english}
+            angleLimit={actor.assetRefId && actor.characterRig?.rigType === "mixamo" ? 180 : getBodyTypePoseLimit(actor.bodyType)}
+            onChange={(controls) => setPose({ controls })} />
+          : <p className="motion-clip-hint">{labels.noHumanoidPose}</p>}
+        <label>{labels.interpolation}<select data-testid="motion-clip-interpolation"
+          value={currentActorKey?.interpolation ?? newInterpolation}
+          onChange={(event) => changeInterpolation(event.currentTarget.value === "hold" ? "hold" : "linear")}>
+          <option value="linear">{labels.linear}</option><option value="hold">{labels.hold}</option>
+        </select></label>
+        {session.draftActor?.actorId === actor.id && <p className="motion-clip-hint">{labels.draft}</p>}
+        {currentActorKey && <KeyframeActions key={`${currentActorKey.id}:${currentActorKey.time}`} frame={currentActorKey}
+          labels={labels} duration={clip.duration} onMove={(value) => relocateActorKey(value, false)}
+          onDuplicate={(value) => relocateActorKey(value, true)} onDelete={() => {
+            useDirectorStore.getState().setMotionClip(removeMotionActorFrame(clip, actor.id, currentActorKey.id));
+            seek(time);
+          }} />}
+      </div> : <p className="motion-clip-hint">{labels.noActor}</p> : prop ? <div className="motion-clip-editor">
+        <label>{labels.prop}<select data-testid="motion-clip-prop" value={prop.id} onChange={(event) => {
+          const selected = props.find((item) => item.id === event.currentTarget.value);
+          if (selected) selectTrack(selected);
+        }}>{props.map((item) => <option key={item.id} value={item.id}>{trackName(item, english)}</option>)}</select></label>
+        <label>{labels.hand}<select data-testid="motion-clip-prop-holder" value={newHolderChoice ?? holderChoice(holder)}
+          onChange={(event) => setNewHolderChoice(event.currentTarget.value)}>
+          <option value="floor">{labels.floor}</option>
+          {actors.filter((item) => supportedPose(item, project.assets)).map((item) => (
+            <optgroup key={item.id} label={trackName(item, english)}>
+              <option value={`actor:${item.id}:left`}>{trackName(item, english)} · {labels.leftHand}</option>
+              <option value={`actor:${item.id}:right`}>{trackName(item, english)} · {labels.rightHand}</option>
+            </optgroup>
+          ))}
+        </select></label>
+        {currentPropKey && <button type="button" data-testid="motion-clip-prop-delete" onClick={() => {
+          useDirectorStore.getState().setMotionClip(removeMotionPropFrame(clip, prop.id, currentPropKey.id));
+          seek(time);
+        }}>{labels.deletePropKey}</button>}
+      </div> : <p className="motion-clip-hint">{labels.noProp}</p>}
+      </div>
+      {tab === "actor" ? actor && <button type="button" className="motion-clip-primary" data-testid="motion-clip-add" onClick={saveActorKey}>
+        {currentActorKey ? labels.updateKey : labels.addKey}
+      </button> : prop && <button type="button" className="motion-clip-primary" data-testid="motion-clip-prop-add" onClick={savePropKey}>
+        {currentPropKey ? labels.updatePropKey : labels.addPropKey}
+      </button>}
+      <input type="file" hidden accept=".json,application/json" ref={fileRef} data-testid="motion-clip-project-file" onChange={openProject} />
+    </aside>
+    <MotionClipTimeline labels={labels} english={english} clip={clip} time={time} playing={session.playing} loop={session.loop}
+      tracks={tracks} selectedId={tab === "actor" ? actor?.id ?? null : prop?.id ?? null} onSeek={seek} onDuration={changeDuration}
+      onPlay={() => { setNotice(""); setNewHolderChoice(null); session.togglePlayback(clip.duration); }}
+      onLoop={session.setLoop} onTrack={selectTrack} onFrame={(item, target) => { selectTrack(item); seek(target); }}
+      onSave={saveProject} onOpen={() => fileRef.current?.click()} />
+  </>;
+}
