+import type { PosePresetId } from "../schema/poseSchema";
+
+export const englishPoseNames: Record<PosePresetId, string> = {
+  stand: "Stand", "t-pose": "T-pose", walk: "Walk", run: "Run", sit: "Sit", crouch: "Crouch",
+  "kneel-one": "Kneel on one knee", "kneel-two": "Kneel on both knees", "hands-on-hips": "Hands on hips",
+  lean: "Lean", bow: "Bow", think: "Think", fight: "Staged stance", kick: "Leg raised", throw: "Arm swing",
+  push: "Push", wave: "Wave", reach: "Reach", "cross-arms": "Cross arms", phone: "Phone pose",
+};
+
+const bodyParts = [
+  ["body", "身体", "Body"], ["torso", "躯干", "Torso"], ["head", "头部", "Head"],
+  ["leftShoulder", "左肩", "Left shoulder"], ["rightShoulder", "右肩", "Right shoulder"],
+  ["leftElbow", "左肘", "Left elbow"], ["rightElbow", "右肘", "Right elbow"],
+  ["leftHand", "左手", "Left hand"], ["rightHand", "右手", "Right hand"],
+  ["leftHip", "左髋", "Left hip"], ["rightHip", "右髋", "Right hip"],
+  ["leftKnee", "左膝", "Left knee"], ["rightKnee", "右膝", "Right knee"],
+  ["leftFoot", "左脚", "Left foot"], ["rightFoot", "右脚", "Right foot"],
+] as const;
+
+const axes = {
+  pitch: ["前后转", "Pitch"], yaw: ["左右转", "Yaw"], roll: ["侧转", "Roll"],
+  spread: ["外展", "Spread"], twist: ["扭转", "Twist"], bend: ["弯曲", "Bend"],
+  offsetY: ["高度", "Height"],
+} as const;
+
+function jointAxes(bodyPart: string): (keyof typeof axes)[] {
+  if (/Elbow|Knee/.test(bodyPart)) return ["bend"];
+  if (/Shoulder|Hip/.test(bodyPart)) return ["pitch", "spread", "twist"];
+  return bodyPart === "body" ? ["pitch", "yaw", "roll", "offsetY"] : ["pitch", "yaw", "roll"];
+}
+
+export const clipJointGroups = bodyParts.map(([bodyPart, zh, en]) => ({
+  names: [zh, en],
+  controls: jointAxes(bodyPart).map((axis) => ({ id: `${bodyPart}.${axis}`, names: axes[axis] })),
+}));
diff --git a/src/editor/panels/motionClipWorkspaceLabels.ts b/src/editor/panels/motionClipWorkspaceLabels.ts
