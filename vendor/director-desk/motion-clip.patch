diff --git a/src/editor/panels/MotionClipTimeline.tsx b/src/editor/panels/MotionClipTimeline.tsx
new file mode 100644
index 0000000..e601048
--- /dev/null
+++ b/src/editor/panels/MotionClipTimeline.tsx
@@ -0,0 +1,115 @@
+import { useEffect, useState, type HTMLAttributes } from "react";
+import { Pause, Play, SkipBack } from "lucide-react";
+import { MAX_MOTION_CLIP_SECONDS, MIN_MOTION_CLIP_SECONDS, type MotionClip } from "../schema/motionClip";
+import type { DirectorObject } from "../schema/directorProject";
+import type { ClipLabels } from "./motionClipWorkspaceLabels";
+
+export function ClipNumberField({ value, onCommit, onEdit, min, max, step, ...props }: {
+  value: number;
+  onCommit: (value: number) => void;
+  onEdit?: () => void;
+  min?: number;
+  max?: number;
+  step: number;
+} & Pick<HTMLAttributes<HTMLInputElement>, "aria-label" | "className"> & {
+  "data-testid"?: string;
+}) {
+  const [draft, setDraft] = useState<string | null>(null);
+  useEffect(() => setDraft(null), [value]);
+  return (
+    <input {...props} type="number" step={step} min={min} max={max} value={draft ?? value}
+      onFocus={onEdit} onChange={(event) => setDraft(event.currentTarget.value)}
+      onBlur={(event) => {
+        const number = event.currentTarget.valueAsNumber;
+        if (draft !== null && Number.isFinite(number)) onCommit(number);
+        setDraft(null);
+      }}
+      onKeyDown={(event) => {
+        if (event.key === "Enter") event.currentTarget.blur();
+      }} />
+  );
+}
+
+type Track = { item: DirectorObject; frames: { id: string; time: number; interpolation?: "linear" | "hold" }[] };
+
+export function trackName(item: DirectorObject, english: boolean) {
+  return english ? item.name.replace(/^角色(?=\s*\d+$)/, "Character").replace(/^道具(?=\s*\d+$)/, "Prop") : item.name;
+}
+
+export function MotionClipTimeline({ labels, english, clip, time, playing, loop,
+  tracks, selectedId, onSeek, onDuration, onPlay, onLoop, onTrack, onFrame, onSave, onOpen }: {
+  labels: ClipLabels;
+  english: boolean;
+  clip: MotionClip;
+  time: number;
+  playing: boolean;
+  loop: boolean;
+  tracks: Track[];
+  selectedId: string | null;
+  onSeek: (time: number) => void;
+  onDuration: (duration: number) => void;
+  onPlay: () => void;
+  onLoop: (loop: boolean) => void;
+  onTrack: (item: DirectorObject) => void;
+  onFrame: (item: DirectorObject, time: number) => void;
+  onSave: () => void;
+  onOpen: () => void;
+}) {
+  return (
+    <section className="motion-clip-timeline" aria-label={labels.timeline} data-testid="motion-clip-panel">
+      <div className="motion-clip-timeline-header">
+        <div className="motion-clip-playback">
+          <button type="button" title={labels.start} aria-label={labels.start} onClick={() => onSeek(0)}>
+            <SkipBack aria-hidden="true" size={15} />
+          </button>
+          <button type="button" title={playing ? labels.pause : labels.play}
+            aria-label={playing ? labels.pause : labels.play} data-testid="motion-clip-play" onClick={onPlay}>
+            {playing ? <Pause aria-hidden="true" size={15} /> : <Play aria-hidden="true" size={15} />}
+          </button>
+          <label className="motion-clip-loop"><input type="checkbox" checked={loop} data-testid="motion-clip-loop"
+            onChange={(event) => onLoop(event.currentTarget.checked)} />{labels.loop}</label>
+        </div>
+        <div className="motion-clip-time-fields">
+          <label>{labels.time}<ClipNumberField aria-label={labels.time} data-testid="motion-clip-time"
+            value={time} onCommit={onSeek} onEdit={playing ? onPlay : undefined} min={0} max={clip.duration} step={.001} /></label>
+          <label>{labels.duration}<ClipNumberField aria-label={labels.duration} data-testid="motion-clip-duration"
+            value={clip.duration} onCommit={onDuration} min={MIN_MOTION_CLIP_SECONDS} max={MAX_MOTION_CLIP_SECONDS} step={.1} /></label>
+        </div>
+        <div className="motion-clip-files">
+          <button type="button" data-testid="motion-clip-save" onClick={onSave}>{labels.save}</button>
+          <button type="button" data-testid="motion-clip-open" onClick={onOpen}>{labels.open}</button>
+        </div>
+      </div>
+      <div className="motion-clip-ruler">
+        <input type="range" aria-label={labels.scrub} min={0} max={clip.duration} step={.001} value={time}
+          data-testid="motion-clip-scrub" onChange={(event) => onSeek(event.currentTarget.valueAsNumber)} />
+        <div className="motion-clip-scale" aria-hidden="true">
+          {[0, .25, .5, .75, 1].map((fraction) => (
+            <span key={fraction}>{Number((clip.duration * fraction).toFixed(2))}{labels.second}</span>
+          ))}
+        </div>
+      </div>
+      <div className="motion-clip-lanes">
+        {tracks.length ? tracks.map(({ item, frames }) => (
+          <div key={item.id} className="motion-clip-track" data-testid={`motion-clip-track-${item.id}`}>
+            <button type="button" className="motion-clip-track-label" title={trackName(item, english)}
+              aria-pressed={selectedId === item.id} onClick={() => onTrack(item)}>{trackName(item, english)}</button>
+            <div className="motion-clip-lane" data-kind={item.kind}>
+              {frames.map((frame) => {
+                const caption = `${trackName(item, english)} · ${frame.time}${labels.second}${frame.interpolation === "hold" ? ` · ${labels.hold}` : ""}`;
+                return <button key={frame.id} type="button" title={caption} aria-label={caption}
+                  aria-pressed={selectedId === item.id && time === frame.time}
+                  data-testid={`motion-clip-${item.kind === "prop" ? "prop-key" : "key"}-${frame.id}`}
+                  className={frame.interpolation === "hold" ? "is-held" : undefined}
+                  style={{ insetInlineStart: `${frame.time / clip.duration * 100}%` }}
+                  onClick={() => onFrame(item, frame.time)} />;
+              })}
+              <span className="motion-clip-time-marker" aria-hidden="true"
+                style={{ insetInlineStart: `${time / clip.duration * 100}%` }} />
+            </div>
+          </div>
+        )) : <p className="motion-clip-hint">{labels.emptyTracks}</p>}
+      </div>
+    </section>
+  );
+}
