@@ -0,0 +1,91 @@
+import { useFrame } from "@react-three/fiber";
+import { useMemo, useRef, type MutableRefObject } from "react";
+import { Euler, Quaternion, Vector3, type Group, type Object3D } from "three";
+import type { DirectorTransform } from "../schema/directorProject";
+import type { MotionClipHolder } from "../schema/motionClip";
+import type { DirectorCharacterBoneMap } from "../schema/semanticBody";
+import {
+  DIRECTOR_CHARACTER_BONE_MAP_USER_DATA_KEY,
+  findSemanticBodyPartNode,
+  getDirectorObjectSceneNodeName,
+} from "./semanticBodyTracking";
+
+export const CLIP_PROP_VISUAL_CENTER_Y = "clipPropVisualCenterY";
+
+function isUnderOwner(node: Object3D, owner: Object3D) {
+  for (let ancestor = node.parent; ancestor; ancestor = ancestor.parent) {
+    if (ancestor === owner) return true;
+  }
+  return false;
+}
+
+export function createClipPropTransform() {
+  const center = new Vector3();
+  const rotation = new Quaternion();
+  const parentRotation = new Quaternion();
+  const gripRotation = new Quaternion();
+  const gripEuler = new Euler();
+  const visualOffset = new Vector3();
+
+  return (prop: Object3D, hand: Object3D, base: DirectorTransform, centerY: number, grip?: DirectorTransform) => {
+    const parent = prop.parent;
+    if (!parent) return;
+    center.set(0, 0, 0);
+    if (grip) center.fromArray(grip.position);
+    hand.localToWorld(center);
+    parent.worldToLocal(center);
+    parent.getWorldQuaternion(parentRotation).invert();
+    hand.getWorldQuaternion(rotation);
+    const [x, y, z] = grip?.rotation ?? base.rotation;
+    gripRotation.setFromEuler(gripEuler.set(x, y, z));
+    rotation.premultiply(parentRotation).multiply(gripRotation).normalize();
+    prop.scale.fromArray(base.scale);
+    if (grip) prop.scale.multiply(visualOffset.fromArray(grip.scale));
+    // Primitives and normalized imports sit on their origin. Grip their visual
+    // center, retaining the prop's authored size independently of the hand rig.
+    visualOffset.set(0, centerY * prop.scale.y, 0).applyQuaternion(rotation);
+    prop.position.copy(center).sub(visualOffset);
+    prop.quaternion.copy(rotation);
+    prop.updateMatrixWorld(true);
+  };
+}
+
+export function ClipPropFollower({
+  prop,
+  holder,
+  baseTransform,
+  visualCenterY,
+}: {
+  prop: MutableRefObject<Group>;
+  holder: MotionClipHolder;
+  baseTransform: DirectorTransform;
+  visualCenterY: number;
+}) {
+  const transformProp = useMemo(createClipPropTransform, []);
+  const saved = useRef<{ owner: Object3D; hand: Object3D; side: "left" | "right" } | null>(null);
+
+  useFrame(() => {
+    const object = prop.current;
+    if (!object) return;
+    const ownerName = getDirectorObjectSceneNodeName(holder.actorId);
+    const owner = object.parent?.children.find((child) => child.name === ownerName);
+    if (owner && (!saved.current || saved.current.owner !== owner
+      || saved.current.side !== holder.hand || !isUnderOwner(saved.current.hand, owner))) {
+      const boneMap = owner.userData[DIRECTOR_CHARACTER_BONE_MAP_USER_DATA_KEY] as DirectorCharacterBoneMap | undefined;
+      const hand = findSemanticBodyPartNode(owner, holder.hand === "left" ? "leftHand" : "rightHand", boneMap);
+      saved.current = hand ? { owner, hand, side: holder.hand } : null;
+    }
+    if (owner && saved.current?.owner === owner) {
+      const importedCenter = object.children.find((child) => child.userData[CLIP_PROP_VISUAL_CENTER_Y] != null)
+        ?.userData[CLIP_PROP_VISUAL_CENTER_Y] as number | undefined;
+      transformProp(object, saved.current.hand, baseTransform, importedCenter ?? visualCenterY, holder.offset);
+    } else {
+      // A hidden owner or model still loading can have no renderable palm yet.
+      object.position.fromArray(baseTransform.position);
+      object.rotation.set(...baseTransform.rotation);
+      object.scale.fromArray(baseTransform.scale);
+      object.updateMatrixWorld(true);
+    }
+  });
+  return null;
+}
