diff --git a/src/editor/schema/motionClip.ts b/src/editor/schema/motionClip.ts
new file mode 100644
index 0000000..594fec5
--- /dev/null
+++ b/src/editor/schema/motionClip.ts
@@ -0,0 +1,277 @@
+import { Euler, Quaternion } from "three";
+import type { DirectorObject, DirectorTransform } from "./directorProject";
+
+export const MIN_MOTION_CLIP_SECONDS = 0.1;
+export const MAX_MOTION_CLIP_SECONDS = 5;
+
+export interface MotionClipActorPose {
+  transform: DirectorTransform;
+  controls: Record<string, number>;
+}
+
+export interface MotionClipActorKeyframe extends MotionClipActorPose {
+  id: string;
+  time: number;
+  /** How this frame changes into the next one on the same actor's track. */
+  interpolation: "linear" | "hold";
+}
+
+export interface MotionClipHolder {
+  actorId: string;
+  hand: "left" | "right";
+  /** Optional placement in the holder's hand coordinates. */
+  offset?: DirectorTransform;
+}
+
+export interface MotionClipPropKeyframe {
+  id: string;
+  time: number;
+  holder: MotionClipHolder | null;
+}
+
+export interface MotionClipActorTrack {
+  actorId: string;
+  keyframes: MotionClipActorKeyframe[];
+}
+
+export interface MotionClipPropTrack {
+  propId: string;
+  keyframes: MotionClipPropKeyframe[];
+}
+
+export interface MotionClip {
+  duration: number;
+  actorTracks: MotionClipActorTrack[];
+  propTracks: MotionClipPropTrack[];
+}
+
+type Frame = { id: string; time: number };
+type Vector = DirectorTransform["position"];
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+function isNumber(value: unknown): value is number {
+  return typeof value === "number" && Number.isFinite(value);
+}
+
+function isId(value: unknown): value is string {
+  return typeof value === "string" && value.trim().length > 0;
+}
+
+function normalizeDuration(value: unknown) {
+  const duration = isNumber(value) ? value : MAX_MOTION_CLIP_SECONDS;
+  return Math.round(Math.max(MIN_MOTION_CLIP_SECONDS, Math.min(duration, MAX_MOTION_CLIP_SECONDS)) * 1000) / 1000;
+}
+
+export function normalizeMotionClipTime(time: number, duration = MAX_MOTION_CLIP_SECONDS) {
+  const value = isNumber(time) ? time : 0;
+  return Math.round(Math.max(0, Math.min(value, normalizeDuration(duration))) * 1000) / 1000;
+}
+
+export function createMotionClip(duration = MAX_MOTION_CLIP_SECONDS): MotionClip {
+  return { duration: normalizeDuration(duration), actorTracks: [], propTracks: [] };
+}
+
+function vector(value: unknown): Vector | undefined {
+  if (!Array.isArray(value) || value.length !== 3) return undefined;
+  const [x, y, z] = value;
+  return isNumber(x) && isNumber(y) && isNumber(z) ? [x, y, z] : undefined;
+}
+
+function transform(value: unknown): DirectorTransform | undefined {
+  if (!isRecord(value)) return undefined;
+  const position = vector(value.position);
+  const rotation = vector(value.rotation);
+  const scale = vector(value.scale);
+  return position && rotation && scale ? { position, rotation, scale } : undefined;
+}
+
+function frameHeader(value: Record<string, unknown>, duration: number): Frame | undefined {
+  if (!isId(value.id) || !isNumber(value.time) || value.time < 0 || value.time > duration) return undefined;
+  return { id: value.id, time: normalizeMotionClipTime(value.time, duration) };
+}
+
+function uniqueFrames<T extends Frame>(frames: T[]): T[] {
+  const byId = new Map<string, T>();
+  const byTime = new Map<number, T>();
+  for (const frame of frames) {
+    const sameId = byId.get(frame.id);
+    const sameTime = byTime.get(frame.time);
+    if (sameId) byTime.delete(sameId.time);
+    if (sameTime) byId.delete(sameTime.id);
+    byId.set(frame.id, frame);
+    byTime.set(frame.time, frame);
+  }
+  return [...byTime.values()].sort((a, b) => a.time - b.time);
+}
+
+function parseTracks<T extends Frame>(
+  value: unknown,
+  trackId: "actorId" | "propId",
+  allowed: Set<string>,
+  parse: (frame: Record<string, unknown>) => T | undefined
+): Map<string, T[]> {
+  const tracks = new Map<string, T[]>();
+  if (!Array.isArray(value)) return tracks;
+  for (const track of value) {
+    if (!isRecord(track) || !Array.isArray(track.keyframes)) continue;
+    const id = track[trackId];
+    if (!isId(id) || !allowed.has(id)) continue;
+    const frames = tracks.get(id) ?? [];
+    for (const raw of track.keyframes) {
+      const frame = isRecord(raw) ? parse(raw) : undefined;
+      if (frame) frames.push(frame);
+    }
+    if (frames.length) tracks.set(id, frames);
+  }
+  return tracks;
+}
+
+export function normalizeMotionClip(value: unknown, objects: readonly DirectorObject[]): MotionClip | undefined {
+  if (!isRecord(value)) return undefined;
+  const duration = normalizeDuration(value.duration);
+  const actors = new Set(objects.filter((item) => item.kind === "character").map((item) => item.id));
+  const props = new Set(objects.filter((item) => item.kind === "prop").map((item) => item.id));
+  const actorTracks = parseTracks<MotionClipActorKeyframe>(value.actorTracks, "actorId", actors, (raw) => {
+    const frame = frameHeader(raw, duration);
+    const baseTransform = transform(raw.transform);
+    if (!frame || !baseTransform) return undefined;
+    const controls = isRecord(raw.controls)
+      ? Object.fromEntries(Object.entries(raw.controls).filter(
+          (entry): entry is [string, number] => /^[a-z]+\.[a-z]+$/i.test(entry[0]) && isNumber(entry[1])))
+      : {};
+    return {
+      ...frame,
+      transform: baseTransform,
+      controls,
+      interpolation: raw.interpolation === "hold" ? "hold" : "linear",
+    };
+  });
+  const propTracks = parseTracks<MotionClipPropKeyframe>(value.propTracks, "propId", props, (raw) => {
+    const frame = frameHeader(raw, duration);
+    if (!frame) return undefined;
+    if (raw.holder === null) return { ...frame, holder: null };
+    if (!isRecord(raw.holder)) return undefined;
+    const { actorId, hand } = raw.holder;
+    if (!isId(actorId) || (hand !== "left" && hand !== "right")) return undefined;
+    if (!actors.has(actorId)) return { ...frame, holder: null };
+    const offset = transform(raw.holder.offset);
+    return { ...frame, holder: { actorId, hand, ...(offset && { offset }) } };
+  });
+  return {
+    duration,
+    actorTracks: [...actorTracks].map(([actorId, frames]) => ({ actorId, keyframes: uniqueFrames(frames) })),
+    propTracks: [...propTracks].map(([propId, frames]) => ({ propId, keyframes: uniqueFrames(frames) })),
+  };
+}
+
+function insertFrame<T extends Frame>(keyframes: T[], frame: T, duration: number) {
+  const time = normalizeMotionClipTime(frame.time, duration);
+  return [...keyframes.filter((key) => key.id !== frame.id && key.time !== time), { ...frame, time }]
+    .sort((a, b) => a.time - b.time);
+}
+
+export function upsertMotionActorFrame(clip: MotionClip, actorId: string, frame: MotionClipActorKeyframe): MotionClip {
+  const current = clip.actorTracks.find((track) => track.actorId === actorId);
+  const updated = { actorId, keyframes: insertFrame(current?.keyframes ?? [], frame, clip.duration) };
+  const actorTracks = current
+    ? clip.actorTracks.map((track) => track === current ? updated : track)
+    : [...clip.actorTracks, updated];
+  return { ...clip, actorTracks };
+}
+
+export function upsertMotionPropFrame(clip: MotionClip, propId: string, frame: MotionClipPropKeyframe): MotionClip {
+  const current = clip.propTracks.find((track) => track.propId === propId);
+  const updated = { propId, keyframes: insertFrame(current?.keyframes ?? [], frame, clip.duration) };
+  const propTracks = current
+    ? clip.propTracks.map((track) => track === current ? updated : track)
+    : [...clip.propTracks, updated];
+  return { ...clip, propTracks };
+}
+
+export function removeMotionActorFrame(clip: MotionClip, actorId: string, id: string): MotionClip {
+  const actorTracks = clip.actorTracks.map((track) => track.actorId === actorId
+    ? { ...track, keyframes: track.keyframes.filter((frame) => frame.id !== id) }
+    : track).filter((track) => track.keyframes.length > 0);
+  return { ...clip, actorTracks };
+}
+
+export function removeMotionPropFrame(clip: MotionClip, propId: string, id: string): MotionClip {
+  const propTracks = clip.propTracks.map((track) => track.propId === propId
+    ? { ...track, keyframes: track.keyframes.filter((frame) => frame.id !== id) }
+    : track).filter((track) => track.keyframes.length > 0);
+  return { ...clip, propTracks };
+}
+
+export function resizeMotionClip(clip: MotionClip, duration: number): MotionClip {
+  const nextDuration = normalizeDuration(duration);
+  const actorTracks = clip.actorTracks.map((track) => ({
+    ...track, keyframes: track.keyframes.filter((frame) => frame.time <= nextDuration),
+  })).filter((track) => track.keyframes.length > 0);
+  const propTracks = clip.propTracks.map((track) => ({
+    ...track, keyframes: track.keyframes.filter((frame) => frame.time <= nextDuration),
+  })).filter((track) => track.keyframes.length > 0);
+  return { duration: nextDuration, actorTracks, propTracks };
+}
+
+function nextFrameIndex(frames: Frame[], time: number) {
+  let lower = 0;
+  let upper = frames.length;
+  while (lower < upper) {
+    const middle = Math.floor((lower + upper) / 2);
+    if (frames[middle].time <= time) lower = middle + 1;
+    else upper = middle;
+  }
+  return lower;
+}
+
+function interpolate(from: number, to: number, progress: number) {
+  return from * (1 - progress) + to * progress;
+}
+
+function interpolateVector(from: Vector, to: Vector, progress: number): Vector {
+  return [interpolate(from[0], to[0], progress), interpolate(from[1], to[1], progress),
+    interpolate(from[2], to[2], progress)];
+}
+
+function interpolateRotation(from: Vector, to: Vector, progress: number): Vector {
+  if (from.every((angle, axis) => angle === to[axis])) return from;
+  const start = new Quaternion().setFromEuler(new Euler(...from));
+  const end = new Quaternion().setFromEuler(new Euler(...to));
+  const result = new Euler().setFromQuaternion(start.slerp(end, progress));
+  return [result.x, result.y, result.z];
+}
+
+export function sampleMotionActor(clip: MotionClip | undefined, actorId: string, time: number): MotionClipActorPose | undefined {
+  const frames = clip?.actorTracks.find((track) => track.actorId === actorId)?.keyframes;
+  if (!frames?.length) return undefined;
+  const current = isNumber(time) ? time : 0;
+  const nextIndex = nextFrameIndex(frames, current);
+  const previous = frames[Math.max(0, nextIndex - 1)];
+  const next = frames[nextIndex];
+  if (nextIndex === 0 || !next || previous.interpolation === "hold" || current === previous.time) {
+    return { transform: previous.transform, controls: previous.controls };
+  }
+  const progress = (current - previous.time) / (next.time - previous.time);
+  const { transform: from, controls: startPose } = previous;
+  const { transform: to, controls: endPose } = next;
+  const jointKeys = new Set([...Object.keys(startPose), ...Object.keys(endPose)]);
+  return {
+    transform: {
+      position: interpolateVector(from.position, to.position, progress),
+      rotation: interpolateRotation(from.rotation, to.rotation, progress),
+      scale: interpolateVector(from.scale, to.scale, progress),
+    },
+    controls: Object.fromEntries([...jointKeys].map((key) => [
+      key, interpolate(startPose[key] ?? 0, endPose[key] ?? 0, progress),
+    ])),
+  };
+}
+
+export function sampleMotionProp(clip: MotionClip | undefined, propId: string, time: number): MotionClipHolder | null | undefined {
+  const frames = clip?.propTracks.find((track) => track.propId === propId)?.keyframes;
+  if (!frames?.length) return undefined;
+  return frames[nextFrameIndex(frames, isNumber(time) ? time : 0) - 1]?.holder;
+}
