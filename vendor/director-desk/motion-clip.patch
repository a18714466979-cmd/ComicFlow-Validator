+import { Euler, Quaternion, Vector3 } from "three";
+import { afterEach, it, expect, vi } from "vitest";
+import { parseProject } from "../../io/importProjectJson";
+import { serializeProject } from "../../io/exportProjectJson";
+import { createDefaultDirectorProject, useDirectorStore } from "../../store/directorStore";
+import type { DirectorObject, DirectorTransform } from "../directorProject";
+import {
+  createMotionClip,
+  normalizeMotionClip,
+  normalizeMotionClipTime,
+  removeMotionActorFrame,
+  removeMotionPropFrame,
+  resizeMotionClip,
+  sampleMotionActor,
+  sampleMotionProp,
+  upsertMotionActorFrame,
+  upsertMotionPropFrame,
+  type MotionClipActorKeyframe,
+} from "../motionClip";
+
+const radians = (degrees: number) => degrees * Math.PI / 180;
+
+function transform(x: number, yaw = 0): DirectorTransform {
+  return { position: [x, 0, 0], rotation: [0, radians(yaw), 0], scale: [1, 1, 1] };
+}
+
+function actorFrame(
+  id: string,
+  time: number,
+  x: number,
+  yaw = 0,
+  controls: Record<string, number> = {},
+  interpolation: MotionClipActorKeyframe["interpolation"] = "linear"
+): MotionClipActorKeyframe {
+  return { id, time, transform: transform(x, yaw), controls, interpolation };
+}
+
+function scene() {
+  const project = createDefaultDirectorProject();
+  const first = project.objects.find((item) => item.kind === "character")!;
+  const second: DirectorObject = { ...first, id: "receiver", name: "Receiver", transform: transform(2, 180) };
+  const envelope: DirectorObject = {
+    id: "envelope", name: "Envelope", kind: "prop", visible: true, locked: false,
+    transform: transform(0), geometryType: "box",
+  };
+  project.objects.push(second, envelope);
+  return { project, first, second, envelope };
+}
+
+afterEach(() => vi.unstubAllGlobals());
+
+it("holds and blends a single actor's full pose and rotates along the short arc", () => {
+  let clip = createMotionClip();
+  clip = upsertMotionActorFrame(clip, "actor", actorFrame("start", 0, 0, 170, { "head.yaw": 12 }));
+  clip = upsertMotionActorFrame(clip, "actor", actorFrame("raised", 2, 2, -170, {
+    "leftShoulder.pitch": -80, "body.offsetY": -.4,
+  }, "hold"));
+  clip = upsertMotionActorFrame(clip, "actor", actorFrame("finish", 5, 3, -170, { "head.yaw": 24 }));
+  const middle = sampleMotionActor(clip, "actor", 1)!;
+  expect(middle.transform.position).toEqual([1, 0, 0]);
+  expect(middle.controls).toEqual({ "head.yaw": 6, "leftShoulder.pitch": -40, "body.offsetY": -.2 });
+  const facing = new Vector3(0, 0, 1).applyQuaternion(new Quaternion().setFromEuler(new Euler(...middle.transform.rotation)));
+  expect(facing.z).toBeCloseTo(-1);
+  expect(sampleMotionActor(clip, "actor", 4.999)).toEqual(sampleMotionActor(clip, "actor", 2));
+  expect(sampleMotionActor(clip, "actor", 5)?.controls).toEqual({ "head.yaw": 24 });
+  expect(sampleMotionActor(clip, "another", 3)).toBeUndefined();
+});
+
+it("changes an envelope's holder once while two independent actor tracks keep evaluating", () => {
+  const { first, second, envelope } = scene();
+  let clip = createMotionClip();
+  clip = upsertMotionActorFrame(clip, first.id, actorFrame("giver-start", 0, -1, 80));
+  clip = upsertMotionActorFrame(clip, first.id, actorFrame("giver-reach", 1.5, -.5, 80, { "rightElbow.bend": 55 }));
+  clip = upsertMotionActorFrame(clip, first.id, actorFrame("giver-out", 5, -1, 80));
+  clip = upsertMotionActorFrame(clip, second.id, actorFrame("receiver-seated", 0, 1, -80, { "leftHip.pitch": 80 }));
+  clip = upsertMotionActorFrame(clip, second.id, actorFrame("receiver-arrival", 3, 1, -80, { "leftElbow.bend": 68 }));
+  const giving = { actorId: first.id, hand: "right" as const };
+  const receiving = { actorId: second.id, hand: "left" as const };
+  clip = upsertMotionPropFrame(clip, envelope.id, { id: "initial", time: 0, holder: giving });
+  clip = upsertMotionPropFrame(clip, envelope.id, { id: "handoff", time: 3, holder: receiving });
+  expect([0, 1.5, 2.999, 3, 5].map((time) => sampleMotionProp(clip, envelope.id, time))).toEqual([
+    giving, giving, giving, receiving, receiving,
+  ]);
+  expect(sampleMotionActor(clip, first.id, 3)?.transform.position[0]).toBeCloseTo(-.7142857);
+  expect(sampleMotionActor(clip, second.id, 3)?.controls).toEqual({ "leftElbow.bend": 68 });
+  const afterUnbind = upsertMotionPropFrame(clip, envelope.id, { id: "put-down", time: 4, holder: null });
+  expect(sampleMotionProp(afterUnbind, envelope.id, 3.999)).toEqual(receiving);
+  expect(sampleMotionProp(afterUnbind, envelope.id, 4)).toBeNull();
+  expect(sampleMotionProp(afterUnbind, "no-track", 4)).toBeUndefined();
+});
+
+it("keeps stable key IDs through move, copy, replace, remove, and duration edits", () => {
+  let clip = createMotionClip(20);
+  expect(clip.duration).toBe(5);
+  expect(normalizeMotionClipTime(1.23472, 5)).toBe(1.235);
+  const first = actorFrame("original", 0, 0);
+  clip = upsertMotionActorFrame(clip, "actor", first);
+  clip = upsertMotionActorFrame(clip, "actor", { ...first, id: "copy", time: 3 });
+  clip = upsertMotionActorFrame(clip, "actor", actorFrame("copy", 2, 2));
+  expect(clip.actorTracks[0].keyframes.map(({ id, time }) => [id, time])).toEqual([["original", 0], ["copy", 2]]);
+  clip = upsertMotionActorFrame(clip, "actor", actorFrame("replacement", 2, 5));
+  expect(clip.actorTracks[0].keyframes.map(({ id }) => id)).toEqual(["original", "replacement"]);
+  clip = upsertMotionPropFrame(clip, "prop", { id: "held", time: 2, holder: { actorId: "actor", hand: "left" } });
+  expect(resizeMotionClip(clip, 1)).toEqual({
+    duration: 1, actorTracks: [{ actorId: "actor", keyframes: [first] }], propTracks: [],
+  });
+  expect(removeMotionPropFrame(clip, "prop", "held").propTracks).toEqual([]);
+  clip = removeMotionActorFrame(removeMotionActorFrame(clip, "actor", "original"), "actor", "replacement");
+  expect(clip.actorTracks).toEqual([]);
+});
+
+it("normalizes imported tracks without breaking legacy projects, rejects invalid keys and clears stale owners", () => {
+  const { project, first, second, envelope } = scene();
+  expect(normalizeMotionClip(undefined, project.objects)).toBeUndefined();
+  const original = actorFrame("valid", 1, 0, 0, { "rightHand.pitch": 25, "rightFoot.yaw": 12, "body.offsetY": -.4 });
+  const clip = normalizeMotionClip({ duration: 5, actorTracks: [
+    { actorId: first.id, keyframes: [original, actorFrame("future", 6, 0), actorFrame("nan", 1, NaN)] },
+    { actorId: envelope.id, keyframes: [actorFrame("wrong-type", 0, 0)] },
+    { actorId: "missing", keyframes: [actorFrame("orphan", 0, 0)] },
+  ], propTracks: [
+    { propId: envelope.id, keyframes: [
+      { id: "first", time: 0, holder: { actorId: first.id, hand: "right", offset: transform(.05) } },
+      { id: "gone", time: 3, holder: { actorId: "deleted", hand: "left" } },
+      { id: "new", time: 4, holder: { actorId: second.id, hand: "left" } },
+    ] },
+  ] }, project.objects)!;
+  expect(clip.actorTracks).toEqual([{ actorId: first.id, keyframes: [original] }]);
+  expect(sampleMotionProp(clip, envelope.id, 2)?.offset?.position).toEqual([.05, 0, 0]);
+  expect(sampleMotionProp(clip, envelope.id, 3)).toBeNull();
+  expect(sampleMotionProp(clip, envelope.id, 4)).toEqual({ actorId: second.id, hand: "left" });
+});
+
+it("persists keyframes through save, reopen and undo without changing the ordinary camera or rest pose", () => {
+  const storage = new Map<string, string>();
+  vi.stubGlobal("localStorage", {
+    getItem: (key: string) => storage.get(key) ?? null,
+    setItem: (key: string, value: string) => storage.set(key, value),
+  });
+  const store = useDirectorStore.getState;
+  store().openScopedScene("motion-clip-roundtrip");
+  const { project, first, second, envelope } = scene();
+  const legacy = parseProject(JSON.stringify(project));
+  store().replaceProject(legacy);
+  expect("motionClip" in store().project).toBe(false);
+  let clip = upsertMotionActorFrame(createMotionClip(), first.id, actorFrame("start", 0, 2, 90));
+  clip = upsertMotionPropFrame(clip, envelope.id, { id: "handoff", time: 3, holder: { actorId: second.id, hand: "left" } });
+  const cameras = JSON.stringify(store().project.cameras);
+  const objects = JSON.stringify(store().project.objects);
+  store().setMotionClip(clip);
+  const persisted = JSON.stringify(store().project.motionClip);
+  store().setMotionClip(resizeMotionClip(clip, 2));
+  store().undo();
+  expect(JSON.stringify(store().project.motionClip)).toBe(persisted);
+  const file = serializeProject(store().project);
+  store().openScopedScene("motion-clip-roundtrip");
+  expect(JSON.stringify(store().project.motionClip)).toBe(persisted);
+  store().replaceProject(parseProject(file));
+  expect(JSON.stringify(store().project.motionClip)).toBe(persisted);
+  expect(JSON.stringify(store().project.cameras)).toBe(cameras);
+  expect(JSON.stringify(store().project.objects)).toBe(objects);
+  store().selectObject(second.id);
+  store().deleteSelectedObject();
+  expect(sampleMotionProp(store().project.motionClip, envelope.id, 4)).toBeNull();
+  store().undo();
+  expect(sampleMotionProp(store().project.motionClip, envelope.id, 4)).toEqual({ actorId: second.id, hand: "left" });
+  store().setMotionClip(undefined);
+  expect("motionClip" in store().project).toBe(false);
+});
