+import { create } from "zustand";
+import type { DirectorTransform } from "../schema/directorProject";
+
+export interface MotionClipActorDraft {
+  actorId: string;
+  transform: DirectorTransform;
+  controls: Record<string, number>;
+}
+
+interface MotionClipSession {
+  active: boolean;
+  time: number;
+  playing: boolean;
+  loop: boolean;
+  selectedActorId: string | null;
+  draftActor: MotionClipActorDraft | null;
+  open: (actorId: string | null) => void;
+  close: () => void;
+  seek: (time: number) => void;
+  selectActor: (actorId: string | null) => void;
+  setDraftActor: (draft: MotionClipActorDraft | null) => void;
+  togglePlayback: (duration: number) => void;
+  setLoop: (loop: boolean) => void;
+  advance: (seconds: number, duration: number) => void;
+}
+
+export const useMotionClipSession = create<MotionClipSession>((set, get) => ({
+  active: false,
+  time: 0,
+  playing: false,
+  loop: true,
+  selectedActorId: null,
+  draftActor: null,
+  open: (selectedActorId) => set({ active: true, time: 0, playing: false, selectedActorId, draftActor: null }),
+  close: () => set({ active: false, time: 0, playing: false, selectedActorId: null, draftActor: null }),
+  seek: (time) => set({ time, playing: false, draftActor: null }),
+  selectActor: (selectedActorId) => set({ selectedActorId, playing: false, draftActor: null }),
+  setDraftActor: (draftActor) => set({ draftActor, playing: false }),
+  togglePlayback: (duration) => {
+    const { playing, time } = get();
+    set(playing ? { playing: false } : { time: time >= duration ? 0 : time, playing: true, draftActor: null });
+  },
+  setLoop: (loop) => set({ loop }),
+  advance: (seconds, duration) => {
+    const { playing, time, loop } = get();
+    if (!playing) return;
+    const nextTime = time + seconds;
+    set(nextTime < duration ? { time: nextTime }
+      : loop ? { time: nextTime % duration } : { time: duration, playing: false });
+  },
+}));
