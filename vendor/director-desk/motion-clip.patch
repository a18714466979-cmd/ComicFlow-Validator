diff --git a/src/editor/runtime/__tests__/ClipPropFollower.test.ts b/src/editor/runtime/__tests__/ClipPropFollower.test.ts
new file mode 100644
index 0000000..49e2e86
--- /dev/null
+++ b/src/editor/runtime/__tests__/ClipPropFollower.test.ts
@@ -0,0 +1,66 @@
+import { Group, Vector3 } from "three";
+import type { DirectorTransform } from "../../schema/directorProject";
+import { createClipPropTransform } from "../ClipPropFollower";
+
+const base: DirectorTransform = { position: [7, 0, 6], rotation: [0, 0, 0], scale: [0.28, 0.055, 0.15] };
+
+function handOf(scene: Group, x: number, armAngle: number) {
+  const actor = new Group();
+  const elbow = new Group();
+  const palm = new Group();
+  scene.add(actor);
+  actor.position.x = x;
+  actor.add(elbow);
+  elbow.position.set(0.28, 1.6, 0);
+  elbow.rotation.x = armAngle;
+  elbow.add(palm);
+  palm.position.set(0, -0.38, 0.06);
+  return { actor, elbow, palm };
+}
+
+it("anchors a single prop to its selected hand through arm and body changes in a transformed scene", () => {
+  const scene = new Group();
+  scene.position.set(8, -3, 6);
+  scene.rotation.y = 0.63;
+  scene.scale.setScalar(1.3);
+  const giver = handOf(scene, -0.65, -1.4);
+  const receiver = handOf(scene, 0.65, -1.1);
+  const prop = new Group();
+  scene.add(prop);
+  const apply = createClipPropTransform();
+  const center = () => prop.localToWorld(new Vector3(0, 0.5, 0));
+  const worldGrip = (hand: Group) => hand.getWorldPosition(new Vector3());
+
+  apply(prop, giver.palm, base, 0.5);
+  const start = center();
+  expect(start.distanceTo(worldGrip(giver.palm))).toBeLessThan(1e-7);
+  giver.actor.rotation.y = 0.3;
+  giver.elbow.rotation.x = -1.8;
+  apply(prop, giver.palm, base, 0.5);
+  expect(center().distanceTo(start)).toBeGreaterThan(0.1);
+  expect(center().distanceTo(worldGrip(giver.palm))).toBeLessThan(1e-7);
+
+  apply(prop, receiver.palm, base, 0.5);
+  expect(center().distanceTo(worldGrip(receiver.palm))).toBeLessThan(1e-7);
+  expect(center().distanceTo(worldGrip(giver.palm))).toBeGreaterThan(0.3);
+  expect(scene.children.filter((child) => child === prop)).toHaveLength(1);
+  expect(prop.scale.toArray()).toEqual(base.scale);
+  // Re-evaluating a time or seeking back uses the same palm/world transform.
+  const afterSwitch = center();
+  apply(prop, giver.palm, base, 0.5);
+  apply(prop, receiver.palm, base, 0.5);
+  expect(center().distanceTo(afterSwitch)).toBeLessThan(1e-7);
+});
+
+it("supports an explicitly authored offset in the holder's hand space", () => {
+  const scene = new Group();
+  const { palm } = handOf(scene, 1.5, -1.2);
+  const prop = new Group();
+  scene.add(prop);
+  const grip: DirectorTransform = { position: [0, 0.07, 0.015], rotation: [0.15, 0.25, 0], scale: [2, 1, 0.5] };
+  createClipPropTransform()(prop, palm, base, 0.5, grip);
+  const gripPosition = palm.localToWorld(new Vector3(...grip.position));
+  const center = prop.localToWorld(new Vector3(0, 0.5, 0));
+  expect(center.distanceTo(gripPosition)).toBeLessThan(1e-7);
+  expect(prop.scale.toArray()).toEqual([0.56, 0.055, 0.075]);
+});
