+const zh = {
+  title: "动作片段", timeline: "动作片段时间轴", start: "回到起点", play: "播放片段", pause: "暂停片段", loop: "循环",
+  time: "时间（秒）", duration: "时长（秒）", scrub: "拖动预览时间", second: " 秒", save: "保存工程", open: "打开工程",
+  emptyTracks: "添加人物或道具，然后记录第一个关键帧。", actorTab: "人物轨", propTab: "道具轨", actor: "人物",
+  prop: "道具", noActor: "先在视口工具栏添加人物。", noProp: "先在视口工具栏添加道具。", position: "位置",
+  rotation: "朝向（°）", posePreset: "姿势预设", choosePreset: "选择姿势", joint: "关节微调", degrees: "角度（°）",
+  height: "高度", interpolation: "到下一帧", linear: "线性过渡", hold: "保持至下一帧", keyTime: "目标时间（秒）",
+  addKey: "添加关键帧", updateKey: "更新关键帧", move: "移动", copy: "复制", delete: "删除", undo: "撤销",
+  draft: "姿势已调整，记录关键帧后保存。", unsafeDuration: "片段不能短于最后一个关键帧。请先移动或删除超出时长的关键帧。",
+  keyConflict: "这个时间已有关键帧，请选择其他时间。", hand: "从此时刻开始跟随", floor: "留在场景位置", leftHand: "左手",
+  rightHand: "右手", addPropKey: "记录道具归属", updatePropKey: "更新道具归属", deletePropKey: "删除归属关键帧",
+  noHumanoidPose: "此模型可记录位置和朝向，姿势编辑需要兼容的人形骨架。", saved: "已导出动作工程。",
+  opened: "已打开导演台工程。", openFailed: "无法打开导演台工程。请选择有效的 JSON 文件，大小不超过 32 MiB。",
+} as const;
+
+const en = {
+  title: "Action clip", timeline: "Action clip timeline", start: "Back to start", play: "Play clip", pause: "Pause clip", loop: "Loop",
+  time: "Time (s)", duration: "Duration (s)", scrub: "Scrub preview time", second: " s", save: "Save project", open: "Open project",
