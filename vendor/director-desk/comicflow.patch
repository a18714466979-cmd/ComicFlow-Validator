index 0000000..6da267d
--- /dev/null
+++ b/src/editor/runtime/mannequin/__tests__/ProceduralMannequin.joints.test.tsx
@@ -0,0 +1,138 @@
+import { renderToStaticMarkup } from "react-dom/server";
+import { Euler, Matrix4, Quaternion, Vector3 } from "three";
+import { CHARACTER_ACTION_PRESETS, sampleCharacterActionControls } from "../../../presets/characterActionPresets";
+import { MANNEQUIN_POSE_PRESETS } from "../../../presets/mannequinPosePresets";
+import { BODY_TYPE_OPTIONS, type CharacterBodyType } from "../bodyTypes";
+import { ProceduralMannequin } from "../ProceduralMannequin";
+
+interface Mesh {
+  center: Vector3;
+  inverse: Matrix4;
+  radius: number;
+  halfLength: number;
+  cylinderBottomRadius?: number;
+  ends: [Vector3, Vector3];
+}
+
+function vector(attribute: string | null, fallback: [number, number, number]) {
+  const values = attribute?.split(",").map(Number) as [number, number, number] | undefined;
+  return values ?? fallback;
+}
+
+function readMeshes(body: CharacterBodyType, controls: Record<string, number>) {
+  const scene = document.createElement("div");
+  scene.innerHTML = renderToStaticMarkup(
+    <ProceduralMannequin bodyType={body} rigState={{ rigType: "mannequin", posePresetId: "stand", controls }} />
+  );
+  const meshes = new Map<string, Mesh>();
+
+  function read(node: Element, parent: Matrix4) {
+    const position = new Vector3(...vector(node.getAttribute("position"), [0, 0, 0]));
+    const rotation = new Quaternion().setFromEuler(new Euler(...vector(node.getAttribute("rotation"), [0, 0, 0])));
+    const scale = new Vector3(...vector(node.getAttribute("scale"), [1, 1, 1]));
+    const world = parent.clone().multiply(new Matrix4().compose(position, rotation, scale));
+    if (node.localName === "mesh" && node.firstElementChild && node.hasAttribute("name")) {
+      const geometry = node.firstElementChild;
+      if (["spheregeometry", "capsulegeometry", "cylindergeometry"].includes(geometry.localName)) {
+        const args = geometry.getAttribute("args")!.split(",").map(Number);
+        const cylinder = geometry.localName === "cylindergeometry";
+        const halfLength = cylinder ? args[2] / 2 : geometry.localName === "capsulegeometry" ? args[1] / 2 : 0;
+        meshes.set(node.getAttribute("name")!, {
+          center: new Vector3().applyMatrix4(world),
+          inverse: world.clone().invert(),
+          radius: args[0],
+          halfLength,
+          cylinderBottomRadius: cylinder ? args[1] : undefined,
+          ends: [new Vector3(0, -halfLength, 0).applyMatrix4(world),
+                 new Vector3(0, halfLength, 0).applyMatrix4(world)],
+        });
+      }
+    }
+    for (const child of Array.from(node.children)) read(child, world);
+  }
+
+  read(scene.firstElementChild!, new Matrix4());
+  return meshes;
+}
+
+function inside(point: Vector3, mesh: Mesh) {
+  const local = point.clone().applyMatrix4(mesh.inverse);
+  if (mesh.cylinderBottomRadius !== undefined) {
+    const t = (local.y + mesh.halfLength) / (2 * mesh.halfLength);
+    const radius = mesh.cylinderBottomRadius * (1 - t) + mesh.radius * t;
+    return Math.abs(local.y) < mesh.halfLength - 0.001 && Math.hypot(local.x, local.z) < radius - 0.001;
+  }
+  const nearestY = Math.max(-mesh.halfLength, Math.min(mesh.halfLength, local.y));
+  return Math.hypot(local.x, local.y - nearestY, local.z) < mesh.radius - 0.001;
+}
+
+function overlap(first: Mesh, second: Mesh) {
+  // Look for an interior point on the chord joining the closest parts of both mesh spines.
+  // This proves overlap in rendered coordinates even after nonuniform body-preset scaling.
+  const nearest = (from: Vector3, onto: Mesh) => {
+    const axis = onto.ends[1].clone().sub(onto.ends[0]);
+    const length = axis.lengthSq();
+    const t = length ? Math.max(0, Math.min(1, from.clone().sub(onto.ends[0]).dot(axis) / length)) : 0;
+    return onto.ends[0].clone().addScaledVector(axis, t);
+  };
+  const probes = [first.center, ...first.ends];
+  return probes.some((point) => crossesBoth(point, nearest(point, second), first, second))
+    || [second.center, ...second.ends].some((point) => crossesBoth(point, nearest(point, first), first, second));
+}
+
+function crossesBoth(from: Vector3, to: Vector3, first: Mesh, second: Mesh) {
+  for (let sample = 0; sample <= 24; sample++) {
+    const point = from.clone().lerp(to, sample / 24);
+    if (inside(point, first) && inside(point, second)) return true;
+  }
+  return false;
+}
+
+function assertConnected(body: CharacterBodyType, pose: string, controls: Record<string, number>) {
+  const meshes = readMeshes(body, controls);
+  const connections: string[][] = [
+    ["pelvis", "abdomen"],
+    ["abdomen", "chest", "neck", "head"],
+  ];
+  for (const side of ["left", "right"]) {
+    connections.push(
+      ["chest", `${side}-shoulder-joint`, `${side}-upper-arm`, `${side}-elbow-joint`, `${side}-forearm`, `${side}-wrist-joint`, `${side}-hand`],
+      ["pelvis", `${side}-hip-joint`, `${side}-thigh`, `${side}-knee-joint`, `${side}-calf`, `${side}-ankle-joint`, `${side}-foot`]
+    );
+  }
+  for (const chain of connections) {
+    for (let index = 1; index < chain.length; index++) {
+      const [a, b] = chain.slice(index - 1, index + 1);
+      const first = meshes.get(`humanoid-${a}`);
+      const second = meshes.get(`humanoid-${b}`);
+      expect(first && second && overlap(first, second), `${body}, ${pose}: ${a} → ${b}`).toBe(true);
+    }
+  }
+  return meshes;
+}
+
+it("keeps the pelvis in the same body frame when the torso bends and turns", () => {
+  const resting = readMeshes("mannequin", {}).get("humanoid-pelvis")!.center;
+  const rotated = readMeshes("mannequin", { "torso.pitch": -45, "torso.yaw": 30, "torso.roll": 32 });
+  expect(rotated.get("humanoid-pelvis")!.center.distanceTo(resting)).toBeLessThan(1e-6);
+  expect(rotated.get("humanoid-chest")!.center.distanceTo(readMeshes("mannequin", {}).get("humanoid-chest")!.center))
+    .toBeGreaterThan(0.1);
+});
+
+it.each(BODY_TYPE_OPTIONS.map(({ bodyType }) => bodyType))(
+  "keeps every %s joint connected in stored poses and sampled motion",
+  (body) => {
+    assertConnected(body, "manual lean/turn", { "torso.pitch": -45, "torso.yaw": 30, "torso.roll": 32 });
+    assertConnected(body, "manual head tilt", { "head.pitch": 90, "head.roll": 90 });
+    assertConnected(body, "manual head roll", { "head.roll": 90 });
+    for (const { id, controls } of MANNEQUIN_POSE_PRESETS) {
+      assertConnected(body, id, controls);
+    }
+    for (const action of CHARACTER_ACTION_PRESETS) {
+      for (const progress of [0, 0.25, 0.5, 0.75]) {
+        assertConnected(body, `${action.id}@${progress}`,
+          sampleCharacterActionControls(action.id, action.duration * progress));
+      }
+    }
+  }
+);
